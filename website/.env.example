# Database (optional - for storing leads)
DATABASE_URL="postgresql://user:password@localhost:5432/anha_db"

# Telegram Bot Notification (required for lead alerts)
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_chat_id"
# Client-side fallback (embedded in JS bundle - only needed for static hosting)
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN="your_bot_token"
NEXT_PUBLIC_TELEGRAM_CHAT_ID="your_chat_id"

# Email via Resend (optional - sign up free at resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxx"
CONTACT_EMAIL="Contact@temchonghanggia.com"

# App
NEXT_PUBLIC_SITE_URL="https://temchonghanggia.com"
