generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id                String        @id @default(cuid())
  companyName       String
  industry          String
  estimatedQuantity String
  contactName       String
  email             String
  phone             String
  message           String?
  status            ContactStatus @default(NEW)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  features    String[]
  useCases    String[]
  imageUrl    String
  icon        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([slug])
}

model CaseStudy {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  client            String
  industry          String
  challenge         String
  solution          String
  result            String
  testimonial       String?
  testimonialAuthor String?
  imageUrl          String
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([slug])
  @@index([industry])
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

// ─── TXNG Digital Signature Models ───────────────────────────────────────────

model TxngDocument {
  id                  String             @id @default(cuid())
  documentCode        String             @unique
  documentType        TxngDocumentType
  submittedBy         String
  submitterEmail      String
  contentHash         String             // SHA-256 of originalContent
  originalContent     String             // Base64-encoded document bytes
  companySignature    String             // Chữ ký số của công ty (Hex)
  companyCertSerial   String             // Số serial chứng chỉ số của công ty
  anhaSignature       String?            // Chữ ký số của An Hà (Hex)
  anhaCertSerial      String?            // Số serial chứng chỉ số của An Hà
  signedPayload       String?            // JSON payload đầy đủ 2 chữ ký gửi bộ
  status              TxngDocumentStatus @default(PENDING_REVIEW)
  rejectionReason     String?
  approvedBy          String?
  approvedAt          DateTime?
  signedAt            DateTime?
  ministryRef         String?            // Mã xác nhận từ hệ thống bộ
  ministrySubmittedAt DateTime?
  ministryResponse    String?            // JSON response từ bộ
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  auditLogs           TxngAuditLog[]

  @@index([status])
  @@index([submitterEmail])
  @@index([documentCode])
  @@index([createdAt])
}

model TxngAuditLog {
  id         String       @id @default(cuid())
  documentId String
  document   TxngDocument @relation(fields: [documentId], references: [id])
  action     String       // SUBMITTED | APPROVED | REJECTED | SIGNED | MINISTRY_SENT | MINISTRY_FAILED
  actor      String       // Email hoặc "system"
  metadata   String?      // JSON string – dữ liệu bổ sung tuỳ action
  createdAt  DateTime     @default(now())

  @@index([documentId])
  @@index([createdAt])
}

enum TxngDocumentType {
  ORDER          // Đơn đặt hàng tem
  CONTRACT       // Hợp đồng
  DECLARATION    // Tờ khai
  CERTIFICATION  // Chứng nhận
}

enum TxngDocumentStatus {
  PENDING_REVIEW    // Chờ An Hà xem xét
  APPROVED          // An Hà đã duyệt, chờ ký số
  REJECTED          // An Hà từ chối
  ANHA_SIGNED       // An Hà đã ký số, chờ nộp bộ
  SUBMITTED         // Đã nộp lên hệ thống bộ thành công
  SUBMISSION_FAILED // Nộp lên bộ thất bại
}
